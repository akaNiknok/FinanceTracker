# clasp / Apps Script auth credentials — NEVER commit these
.clasprc.json
~/.clasprc.json

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
*.log

# Live web-app deploymentId (URL component = credential) — used by release.js
.deploymentid

# Session handoff notes (per-session artifact, not history)
HANDOFF.md

# Copy of the n8n container's /home/node/.n8n — holds encryptionKey + credentials
n8n-data/

# Wrangler local state/cache
worker/.wrangler/

# Local `wrangler dev` secrets (APP_PASS, GAS_URL incl. the API token)
worker/.dev.vars
